# ==============================================================================
# Michael Zhou's Zsh Configuration (Cross-Platform)
# Unified configuration for macOS, Pop!_OS (Linux), and Ubuntu / WSL
# ==============================================================================

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="robbyrussell"

# Plugins
plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
)

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
fi

# Aliases
alias rm="rm -i"

# Functions
function mkcd() {
    mkdir -p "$@" && cd "$1" || return 1
}
export -f mkcd 2>/dev/null || true

# Starship prompt
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# Vi mode
set -o vi

# Autosuggestion keybindings (Ctrl-F to accept)
bindkey '^f' autosuggest-accept 2>/dev/null || true

# Shared Environment & Bins
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"
if [[ -d "$HOME/.local/bin" ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Omnigent
export OMNIGENT_WS_ALLOWED_ORIGINS="https://pop.tail15ede2.ts.net,http://pop.tail15ede2.ts.net"

# ==============================================================================
# OS-Specific Environment ($OSTYPE)
# ==============================================================================

if [[ "$OSTYPE" == darwin* ]]; then
    # Homebrew environment
    if [[ -f /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi

    # macOS PATH adjustments
    path=(
        /opt/homebrew/bin
        /opt/homebrew/sbin
        $HOME/.local/bin
        $path
    )
    export PATH

    # PostgreSQL 16 (Homebrew)
    if [[ -d "/opt/homebrew/opt/postgresql@16" ]]; then
        export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"
        export LDFLAGS="-L/opt/homebrew/opt/postgresql@16/lib ${LDFLAGS:-}"
        export CPPFLAGS="-I/opt/homebrew/opt/postgresql@16/include ${CPPFLAGS:-}"
        export PKG_CONFIG_PATH="/opt/homebrew/opt/postgresql@16/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
    fi

    # Jupyter
    if [[ -d "/opt/homebrew/share/jupyter" ]]; then
        export JUPYTER_PATH="/opt/homebrew/share/jupyter:${JUPYTER_PATH:-}"
    fi

    # Juliaup
    if [[ -d "$HOME/.juliaup/bin" ]]; then
        path=("$HOME/.juliaup/bin" $path)
        export PATH
    fi

elif [[ "$OSTYPE" == linux* ]]; then
    # WSL2 Interoperability
    if grep -qi microsoft /proc/version 2>/dev/null; then
        command -v clip.exe >/dev/null 2>&1 && alias pbcopy="clip.exe"
        command -v explorer.exe >/dev/null 2>&1 && alias open="explorer.exe"
    fi
fi

# Optional machine-local overrides (for uncommitted private tokens/keys)
if [[ -f "$HOME/.zshrc.local" ]]; then
    source "$HOME/.zshrc.local"
fi
